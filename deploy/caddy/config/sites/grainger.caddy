# Grainger -> EMu demo (Streamlit), see deploy/grainger/.
# Streamlit runs with --server.baseUrlPath=grainger, so the prefix is passed
# through unchanged (handle, not handle_path).
redir /grainger /grainger/ permanent

handle /grainger/* {
	basic_auth {
		{$WORKSHOP_USER} {$WORKSHOP_PASSWORD_HASH}
	}
	reverse_proxy grainger:8501
}
