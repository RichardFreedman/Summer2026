# Copy to .env on the server. One shared workshop login protects every
# password-protected app (Melbourne Moods, Grainger, PARADISEC audio analysis);
# the site snippets in config/sites/ all reference these two variables.
# Generate a hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'the-password'
# Keep the single quotes around the hash: it contains $ signs that Docker
# Compose would otherwise try to expand.
#
# Changing these requires recreating the Caddy container (see README), which
# takes every site offline for a few seconds.

WORKSHOP_USER=workshop
WORKSHOP_PASSWORD_HASH='$2a$14$replace-me-with-output-of-caddy-hash-password'
