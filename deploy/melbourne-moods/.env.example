# Copy to .env on the server. .env is gitignored.

# App secrets (read by moodrec/recommender.py)
OPENAI_API_KEY=sk-...
LASTFM_API_KEY=...

# Shared login enforced by Caddy basic auth.
# Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-shared-password'
# Keep the single quotes around the hash: it contains $ signs that Docker
# Compose would otherwise try to expand.
MELBOURNE_MOODS_USER=workshop
MELBOURNE_MOODS_PASSWORD_HASH='$2a$14$replace-me-with-output-of-caddy-hash-password'

# Genre preference mode: "supergenre" (default; dropdown, deterministic, no
# live LLM calls) or "llm" (free-text genres scored per song by OpenAI).
GENRE_MODE=supergenre
